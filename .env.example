# Optional overrides — the app ships with working defaults for the
# arom-production Firebase project (see src/lib/firebase/config.ts).
# Only set these if you're pointing the app at a different Firebase project
# (e.g. a personal dev/staging project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
