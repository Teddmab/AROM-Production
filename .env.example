# Optional overrides — the app ships with working defaults for the
# arom-production Firebase project (see src/lib/firebase/config.ts).
# Only set these if you're pointing the app at a different Firebase project
# (e.g. a personal dev/staging project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the app at the Firebase Local Emulator Suite (AROM-Backend:
# `firebase emulators:start`) instead of live arom-production data.
# VITE_FIREBASE_EMULATOR_FIRESTORE_PORT only needs to be set if the
# Firestore emulator port in AROM-Backend/firebase.json isn't the 8080
# default (e.g. it's already taken locally).
VITE_USE_FIREBASE_EMULATOR=
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=
